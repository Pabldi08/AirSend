<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.3.0</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets/AirSend.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <Content Include="Assets/AirSend-title.png" Link="AirSend-title.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/AirSend.ico" Link="AirSend.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../target/release/airsend_engine.dll" Link="airsend_engine.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildRustEngine" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/.." Command="cargo build --release --locked --target-dir target -p airsend-engine" />
  </Target>
  <Target Name="PublishWinUIResources" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
